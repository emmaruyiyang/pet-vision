# Raw capture and heavy derivatives. These stay on disk, not in the repo.
# Each line names what rebuilds it, where anything does; the CSVs every figure
# and both pages are drawn from ARE committed.

.venv/
__pycache__/
*.pyc
.DS_Store

# 1.2 GB of Neon scene / sensor video and raw gaze — the original capture
pupil_eye_tracking/

# 4186 extracted frames, 559 MB — rebuilt by scripts/extract_paired_frames.py
frames_paired/

# 1.9 GB + 124 MB + 50 MB demo renders — rebuilt by scripts/aoi_video.py
aoi/*.mp4

# 142 MB, and over GitHub's 100 MB per-file limit anyway
deliverable/*.pptx

# Generated by scripts/bundle_viz_html.py
docs/standalone-build/
